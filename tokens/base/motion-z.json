{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": "120ms",
      "base": "180ms",
      "slow": "260ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.2)"
    }
  },
  "z": {
    "$type": "number",
    "dropdown": 1000,
    "sticky": 1100,
    "overlay": 1200,
    "modal": 1300,
    "toast": 1400,
    "max": 9999
  }
}
