{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "size": {
      "$type": "dimension",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "weight": {
      "$type": "fontWeight",
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "lineHeight": {
      "$type": "number",
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.65
    }
  }
}
